* {
    surface:              #ffffff70;   /* blanco 44% */
    surface-input:        #ffffff10;   /* blanco ~6% */

    foreground:           #1d1d1f;
    muted:                #000000;
    selected-foreground:  #ffffff;

    border-soft:          #0000001d;   /* negro 10% */
    selection:            #00000069;   /* negro 45% */

    font: "Google Sans Flex 14";
}

window {
    transparency: "real";

    width: 780px;
    padding: 15px;

    border: 2px;
    border-color: @border-soft;
    border-radius: 30px;

    background-color: @surface;

    children: [ mainbox ];
}

mainbox {
    orientation: vertical;
    spacing: 10px;
    background-color: transparent;

    children: [ content-panel ];
}

content-panel {
    orientation: vertical;
    spacing: 8px;
    background-color: transparent;

    children: [ inputbar, listview ];
}

inputbar {
    padding: 12px 30px;

    background-color: @surface-input;
    text-color: @selected-foreground;

    border: 2px;
    border-color: @border-soft;
    border-radius: 20px;

    children: [ entry ];
}

entry {
    background-color: transparent;

    placeholder: "       Search";
    placeholder-color: @muted;

    text-color: @foreground;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 1px;

    scrollbar: false;
    background-color: transparent;
}

element {
    padding: 8px 10px;
    spacing: 14px;

    border: 0px;
    border-radius: 16px;

    background-color: transparent;
    text-color: @foreground;

    children: [ element-icon, element-text ];
}

element selected {
    background-color: @selection;

    border: 0px;
    border-radius: 25px;

    text-color: @selected-foreground;
}

element selected.element-text {
    background-color: transparent;
    text-color: @selected-foreground;
}

element selected.element-icon {
    background-color: transparent;
    text-color: @selected-foreground;
}

element-icon {
    size: 55px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    vertical-align: 0.5;
    text-color: inherit;
}