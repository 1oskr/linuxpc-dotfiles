* {
    surface:          #f5f5f700;
    surface-input:    #ffffff8c;
    foreground:       #1d1d1f;
    muted:            #6e6e73;
    border-soft:      #ffffffb3;
    selection:        #e5e5e7d9;
    font: "Google Sans Flex 14";
}

window {
    transparency: "real";
    width: 780px;
    padding: 16px;

    border: 1px;
    border-color: @border-soft;
    border-radius: 28px;

    background-color: @surface;
    children: [ mainbox ];
}

mainbox {
    orientation: vertical;
    spacing: 10px;
    background-color: transparent;
    children: [ content-panel ];
}

content-panel {
    orientation: vertical;
    spacing: 8px;
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 12px 14px;

    border: 1px;
    border-color: @border-soft;
    border-radius: 16px;

    background-color: @surface-input;
    text-color: @foreground;
    children: [ entry ];
}

entry {
    placeholder: "Buscar aplicaciones...";
    placeholder-color: @muted;
    background-color: transparent;
    text-color: @foreground;
}

listview {
    lines: 6;
    columns: 1;
    spacing: 4px;
    scrollbar: false;
    background-color: transparent;
}

element {
    padding: 8px 10px;
    spacing: 14px;

    border: 0px;
    border-radius: 16px;
    background-color: transparent;
    text-color: @foreground;
    children: [ element-icon, element-text ];
}

element selected {
    border: 0px;
    border-radius: 16px;
    background-color: @selection;
    text-color: @foreground;
}

element selected element-text,
element selected element-icon {
    background-color: transparent;
    text-color: @foreground;
}

element-icon {
    size: 52px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}
