#!/usr/bin/env bash

set -euo pipefail

WALLPAPER_DIR="$HOME/Pictures/Wallpapers/Waywallen"
HYPRPAPER_CONFIG="$HOME/.config/hypr/hyprpaper.conf"

if ! monitors_json="$(hyprctl monitors -j 2>/dev/null)"; then
    printf 'No se pudo consultar monitores de Hyprland.\n' >&2
    exit 1
fi

if ! monitor_names="$(
    jq -er '
        if type != "array" then
            error("la respuesta no es un arreglo")
        elif length != 3 then
            error("se requieren exactamente 3 monitores activos")
        elif any(.[]; (.name | type) != "string" or (.x | type) != "number") then
            error("faltan name o x válidos")
        else
            sort_by(.x) | .[] | .name
        end
    ' <<<"$monitors_json"
)"; then
    printf 'No se pudieron resolver los tres monitores activos de Hyprland.\n' >&2
    exit 1
fi

mapfile -t monitors <<<"$monitor_names"

destination="$(
    printf '%s\n' \
        "Central" \
        "Izquierdo" \
        "Derecho" \
        "Todos los monitores" |
    rofi -dmenu -i -p "Destino"
)" || exit 0

case "$destination" in
    "Central")
        monitors=("${monitors[1]}")
        ;;
    "Izquierdo")
        monitors=("${monitors[0]}")
        ;;
    "Derecho")
        monitors=("${monitors[2]}")
        ;;
    "Todos los monitores")
        ;;
    *)
        exit 0
        ;;
esac

selected="$(
    find "$WALLPAPER_DIR" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) \
        -print0 |
    sort -z |
    while IFS= read -r -d '' image; do
        printf '%s\0icon\x1f%s\n' "$(basename "$image")" "$image"
    done |
    rofi \
        -dmenu \
        -show-icons \
        -theme-str 'entry { enabled: false; }'
)" || exit 0

[[ -z "$selected" ]] && exit 0

wallpaper="$WALLPAPER_DIR/$selected"
monitor_list="$(IFS=,; printf '%s' "${monitors[*]}")"
temporary="$(mktemp)"

trap 'rm -f "$temporary"' EXIT

awk \
    -v monitors="$monitor_list" \
    -v wallpaper="$wallpaper" '
    BEGIN {
        count = split(monitors, list, ",")

        for (i = 1; i <= count; i++) {
            target[list[i]] = 1
        }
    }

    /^[[:space:]]*wallpaper[[:space:]]*\{/ {
        inside = 1
        matches = 0
    }

    inside && /^[[:space:]]*monitor[[:space:]]*=/ {
        current = $0
        sub(/^[[:space:]]*monitor[[:space:]]*=[[:space:]]*/, "", current)
        sub(/[[:space:]]*$/, "", current)

        if (current in target) {
            matches = 1
        }
    }

    inside && matches && /^[[:space:]]*path[[:space:]]*=/ {
        sub(/path[[:space:]]*=.*$/, "path = " wallpaper)
    }

    /^[[:space:]]*\}[[:space:]]*$/ {
        inside = 0
        matches = 0
    }

    { print }
' "$HYPRPAPER_CONFIG" > "$temporary"

mv "$temporary" "$HYPRPAPER_CONFIG"
trap - EXIT

for monitor in "${monitors[@]}"; do
    hyprctl hyprpaper wallpaper "$monitor, $wallpaper, cover"
done
